        لا توجد حركات محفوظة حتى الآن
      </p>
    )}
  </div>
) : null}
{page === "القيود اليومية" ? (
  <div className="mt-8 rounded-2xl bg-white p-6 shadow-sm">
    <h3 className="mb-6 text-xl font-bold">القيود اليومية</h3>

    {movements.length === 0 ? (
      <p className="py-6 text-center text-slate-500">
