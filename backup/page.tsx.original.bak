  creditTotal -
  Number(openingBalances[account.code]?.debit || 0) -
  debitTotal;

    return grandTotal + (balance > 0 ? balance : 0);
  }, 0)}
</td>
</tr>
    </tbody>
  </table>
  <div className="mt-4 rounded-xl bg-slate-100 p-4 text-sm font-bold">
  {(
